<Window x:Class="Practiceforunstd2.Collections"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practiceforunstd2"
        mc:Ignorable="d"
        Title="Collections" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="CollectionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Background" Value="DarkGreen"/>
            <Setter Property="Foreground" Value="BlanchedAlmond"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Background="#F5F5F5">

        <UniformGrid Rows="4"
                     Columns="3"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">

            <Button Content="ArrayList" Name="ArrayList" Click="ArrayList_Click"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="Hashtable" Click="Hashtable_Click" Content="Hashtable"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="Stack" Click="Stack_Click" Content="Stack"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="Queue" Click="Queue_Click" Content="Queue"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="SortedList" Click="SortedList_Click" Content="SortedList"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="BitArray" Click="BitArray_Click" Content="BitArray"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="ListDictionary" Click="ListDictionary_Click" Content="ListDictionary"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="HybridDictionary" Click="HybridDictionary_Click" Content="HybridDictionary4585"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="NamevalueCollection" Click="NamevalueCollection_Click" Content="NameValueCollection"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="StringCollection" Click="StringCollection_Click" Content="StringCollection"
                    Style="{StaticResource CollectionButtonStyle}"/>

            <Button Name="StringDictionary" Click="StringDictionary_Click"  Content="StringDictionary"
                    Style="{StaticResource CollectionButtonStyle}"/>
            <Button Name="GenericCollections" Click="GenericCollections_Click"   Content="Generic Collections"
         Style="{StaticResource CollectionButtonStyle}"/>

        </UniformGrid>

    </Grid>
</Window>
